+/// Scan for the end and classification of a text span together. Only
+/// complete text words contribute to the high-bit accumulator; the
+/// word containing the boundary is classified up to that boundary.
+fn text_span(bytes: &[u8]) -> (usize, bool) {
+    const ONES: u64 = 0x0101_0101_0101_0101;
+    const HIGH: u64 = 0x8080_8080_8080_8080;
+    let (mut at, mut seen) = (0, 0u64);
+    while let Some(&eight) = bytes.get(at..).and_then(|rest| rest.first_chunk::<8>()) {
+        let x = u64::from_le_bytes(eight);
+        let control = x.wrapping_sub(ONES * 0x20) & !x & HIGH;
+        let flipped = x ^ (ONES * 0x7f);
+        let del = flipped.wrapping_sub(ONES) & !flipped & HIGH;
+        let hit = control | del;
+        if hit != 0 {
+            let n = hit.trailing_zeros() as usize / 8;
+            return (at + n, seen & HIGH == 0 && bytes[at..at + n].is_ascii());
+        }
+        seen |= x;
+        at += 8;
+    }
+    let mut ascii = seen & HIGH == 0;
+    while at < bytes.len() && bytes[at] >= 0x20 && bytes[at] != 0x7f {
+        ascii &= bytes[at] < 0x80;
+        at += 1;
+    }
+    (at, ascii)
