+/// Lossless four-byte grid representation of an ANSI color. The parser's
+/// public enum has a two-byte named-color payload and takes six bytes;
+/// keeping that enum twice in every cell rounds the cell up to 32 bytes.
+/// This private encoding keeps cells at 24 bytes without pointer tagging,
+/// unsafe accesses, or changing the serialized color format.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+#[cfg_attr(feature = "serde", derive(Serialize, Deserialize))]
+#[cfg_attr(feature = "serde", serde(from = "Color", into = "Color"))]
+pub struct CellColor(u32);
+
+impl From<Color> for CellColor {
+    #[inline]
+    fn from(color: Color) -> Self {
+        Self(match color {
+            Color::Named(named) => named as u32,
+            Color::Spec(Rgb { r, g, b }) => 0x0100_0000 | u32::from(r) << 16 | u32::from(g) << 8 | u32::from(b),
+            Color::Indexed(index) => 0x0200_0000 | u32::from(index),
+        })
+    }
+}
+
+impl From<CellColor> for Color {
+    #[inline]
+    fn from(color: CellColor) -> Self {
+        match color.0 >> 24 {
+            1 => Self::Spec(Rgb { r: (color.0 >> 16) as u8, g: (color.0 >> 8) as u8, b: color.0 as u8 }),
+            2 => Self::Indexed(color.0 as u8),
+            _ => {
+                use NamedColor::*;
+                const BASE: [NamedColor; 16] = [Black, Red, Green, Yellow, Blue, Magenta, Cyan, White,
+                    BrightBlack, BrightRed, BrightGreen, BrightYellow, BrightBlue, BrightMagenta, BrightCyan, BrightWhite];
+                const SPECIAL: [NamedColor; 13] = [Foreground, Background, Cursor, DimBlack, DimRed,
+                    DimGreen, DimYellow, DimBlue, DimMagenta, DimCyan, DimWhite, BrightForeground, DimForeground];
+                // Only From<Color> constructs values; deserialization also
+                // goes through Color, never accepts an arbitrary u32.
+                let named = if color.0 < 16 { BASE[color.0 as usize] } else { SPECIAL[(color.0 - 256) as usize] };
+                Self::Named(named)
+            },
+        }
+    }
+}
+
+impl PartialEq<Color> for CellColor {
+    #[inline]
+    fn eq(&self, other: &Color) -> bool {
+        *self == Self::from(*other)
+    }
+}
+
