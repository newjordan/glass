+    #[test]
+    fn inline_id_storage_and_scalar_mapping() {
+        for v in 0..=0x10ffff {
+            if let Some(c) = char::from_u32(v) {
+                let expected = if (0x300..=0x36f).contains(&v) { Some((v - 0x300 + 1) as u16) } else { None };
+                assert_eq!(Cell::mark_id(c), expected);
+            }
+        }
+        for v in 0x300..=0x36f {
+            let mark = char::from_u32(v).unwrap();
+            let mut cell = Cell::default();
+            cell.push_zerowidth(mark);
+            assert!(cell.extra.is_none());
+            assert_eq!(cell.inline_mark, (v - 0x300 + 1) as u16);
+            let mut copy = cell.clone();
+            copy.set_underline_color(None);
+            copy.set_hyperlink(None);
+            assert_eq!(copy.inline_mark, cell.inline_mark);
+            assert!(copy.extra.is_none());
+            copy.push_zerowidth('\u{308}');
+            assert_eq!(copy.inline_mark, 0);
+            assert!(copy.extra.is_some());
+            cell.strip_stale();
+            assert_eq!(cell.inline_mark, 0);
+            assert!(cell.extra.is_none());
+            cell.push_zerowidth(mark);
+            cell.reset(&Cell::default());
+            assert_eq!(cell, Cell::default());
+            assert_eq!(cell.inline_mark, 0);
+        }
+    }
 
