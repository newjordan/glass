+            eprintln!("scroll-witness fast={fast} alt={alt} row={row} delta={delta} op={op} before_m={before_m:?} before_p={before_p:?} after_m={after_m:?} after_p={after_p:?} final_m={final_m:?} got={got:?} expected={expected:?} pass={pass}");
+            cases+=1;
