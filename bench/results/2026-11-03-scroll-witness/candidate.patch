+/// Persistent state for resize-only research. None in the map means uninitialized;
+/// Physical is explicit and must never silently reacquire from a collapsed cell.
+#[derive(Clone, Debug)]
+pub enum ResizeAnchor {
+    Physical,
+    Witness { line: u64, column: f32, delta: f32 },
+}
+
+pub fn choose_resize_anchor(reflow: &Reflow, line: u64, column: f32) -> ResizeAnchor {
+    let index = line as i64 - reflow.old_scrolled as i64 + reflow.old_history as i64;
+    if index < 0 || index >= reflow.old_rows.len() as i64 || !column.is_finite() {
+        return ResizeAnchor::Physical;
+    }
+    let row = index as usize;
+    let mut first = row;
+    while first > 0 && reflow.old_rows[first - 1].wrap { first -= 1; }
+    let mut end = row + 1;
+    while end < reflow.old_rows.len() && reflow.old_rows[end - 1].wrap { end += 1; }
+    let flat = row as f64 * reflow.old_cols as f64 + f64::from(column);
+    let witness = reflow.content.iter().copied().filter(|&i| i >= first * reflow.old_cols && i < end * reflow.old_cols)
+        .min_by(|a,b| ((*a as f64 - flat).abs()).total_cmp(&(*b as f64 - flat).abs()).then(a.cmp(b)));
+    let Some(witness) = witness else { return ResizeAnchor::Physical };
+    let raw = reflow.old_scrolled as i64 - reflow.old_history as i64 + (witness / reflow.old_cols) as i64;
+    if raw < 0 { return ResizeAnchor::Physical; }
+    ResizeAnchor::Witness { line: raw as u64, column: (witness % reflow.old_cols) as f32, delta: (flat - witness as f64) as f32 }
+}
+
+pub fn move_resize_anchor(reflow: &Reflow, anchor: &mut ResizeAnchor, line: u64, column: f32) -> Option<(u64,f32)> {
+    match anchor {
+        ResizeAnchor::Physical => map_anchor(reflow, line, column),
+        ResizeAnchor::Witness { line: witness_line, column: witness_col, delta } => {
+            let (new_line, new_col) = map_anchor(reflow, *witness_line, *witness_col)?;
+            *witness_line = new_line;
+            *witness_col = new_col;
+            let relative = new_line as i64 - reflow.new_scrolled as i64;
+            let flat = relative as f64 * reflow.new_cols as f64 + f64::from(new_col + *delta);
+            let row = (flat / reflow.new_cols as f64).floor() as i64;
+            let col = (flat - row as f64 * reflow.new_cols as f64) as f32;
+            let screen = reflow.new_rows.len() - reflow.new_history;
+            if row < -(reflow.new_history as i64) || row >= screen as i64 { return None; }
+            let raw = reflow.new_scrolled as i64 + row;
+            (raw >= 0).then_some((raw as u64, col))
+        }
+    }
+}
