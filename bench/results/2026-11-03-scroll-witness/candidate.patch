+/// A selected glyph is a one-cell point. Reuse the physical band contract,
+/// but do not use the picture's location to decide whether the glyph moved.
+pub fn scroll_resize_anchor(anchor: &mut ResizeAnchor, band: &BandScroll, columns: usize) -> bool {
+    let ResizeAnchor::Witness { line, column, delta } = anchor else { return true; };
+    let old = *line;
+    let rect = Rect { line: *line, column: *column, width: 1.0, height: 1.0, source: None };
+    match scroll_rect(rect, band, (1, 1)) {
+        Fate::Keep(next) => {
+            *line = next.line;
+            *delta -= ((*line as i128 - old as i128) as f64 * columns as f64) as f32;
+            true
+        },
+        Fate::Gone => false,
+        Fate::Split(_, _) => unreachable!("one-cell point cannot split at integer bands"),
+    }
+}
