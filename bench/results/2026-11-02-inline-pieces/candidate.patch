+/// Ordered destination for the splitter. The parser only appends; callers
+/// choose heap storage or a small inline buffer without changing its states.
+pub trait PieceSink<'a> {
+    fn push(&mut self, piece: Piece<'a>);
+}
+
+impl<'a> PieceSink<'a> for Vec<Piece<'a>> {
+    fn push(&mut self, piece: Piece<'a>) { Vec::push(self, piece); }
+}
+
+impl<'a> PieceSink<'a> for smallvec::SmallVec<[Piece<'a>; 4]> {
+    fn push(&mut self, piece: Piece<'a>) { smallvec::SmallVec::push(self, piece); }
+}
