+    /// At the bottom of a region, several bounded ASCII records can share
+    /// one scroll. Only complete CRLF records are considered; nothing is
+    /// deferred past this call and every character still uses `print_run`.
+    /// The first record retains the old bottom row's unwritten suffix, while
+    /// later records land on the blank rows the bulk scroll recycles.
+    #[inline(never)]
+    fn print_records(&mut self, text: &[u8], first: usize) -> usize {
+        const MAX: usize = 8;
+        if !self.in_cell.is_empty() || self.motion_end.is_some()
+            || self.term.mode().contains(TermMode::INSERT)
+            || self.term.grid().cursor.point.line.0 + 1 != self.region_bottom
+            || self.term.grid().cursor.point.column.0 != 0
+            || self.term.grid().cursor.input_needs_wrap
+        {
+            return 0;
+        }
+        let cursor = &self.term.grid().cursor;
+        if cursor.template.extra.is_some() || cursor.charsets != Default::default() {
+            return 0;
+        }
+        let columns = self.term.columns();
+        let cap = MAX.min((self.region_bottom - self.region_top - 1).max(0) as usize);
+        let mut records = [(0usize, 0usize); MAX];
+        let (mut count, mut at, mut len) = (0, 0, first);
+        while count < cap && len > 0 && len <= columns
+            && text.get(at + len..at + len + 2) == Some(b"\r\n")
+        {
+            records[count] = (at, len);
+            count += 1;
+            at += len + 2;
+            if count < cap {
+                len = ascii_record_len(&text[at..]);
+            }
+        }
+        if count < 2 {
+            return 0;
+        }
+        // No picture can move (motion_end was refused above). Keep the
+        // scroll-count sentinel and primary/alternate accounting on the
+        // same path as ordinary linefeeds, then scroll once, not per row.
+        self.note_scroll_up(self.region_top, count);
+        alacritty_terminal::vte::ansi::Handler::scroll_up(self.term, count);
+        self.term.grid_mut().cursor.point.line = Line(self.region_bottom - 1 - count as i32);
+        for &(start, len) in &records[..count] {
+            let took = self.print_run(&text[start..start + len]);
+            debug_assert_eq!(took, len);
+            alacritty_terminal::vte::ansi::Handler::carriage_return(self.term);
+            self.term.grid_mut().cursor.point.line += 1;
+        }
+        self.drained += count;
+        if self.drained >= SYNC_DRAIN_CHUNK {
+            self.fold_sentinel();
+            self.drained = 0;
+        }
+        at
+    }
