+/// Printable ASCII prefix for a candidate record. The x86 scanner already
+/// computes exact control/high-bit masks; high bytes must stop speculation.
+fn ascii_record_len(bytes: &[u8]) -> usize {
+    #[cfg(target_arch = "x86_64")]
+    {
+        let mut at = 0;
+        while let Some(block) = bytes.get(at..).and_then(|rest| rest.first_chunk::<16>()) {
+            let (control, high) = text_masks(block);
+            let stop = control | high;
+            if stop != 0 {
+                return at + stop.trailing_zeros() as usize;
+            }
+            at += 16;
+        }
+        at + bytes[at..].iter().position(|b| !(0x20..=0x7e).contains(b)).unwrap_or(bytes.len() - at)
+    }
+    #[cfg(not(target_arch = "x86_64"))]
+    {
+        bytes.iter().position(|b| !(0x20..=0x7e).contains(b)).unwrap_or(bytes.len())
+    }
+}
