+    /// Height-only shrinking pushes real rows into history. Picture anchors use
+    /// the same absolute-line count as output scrolling; width reflow is separate.
+    #[test]
+    fn scroll_authority_height_only_resize_preserves_absolute_lines() {
+        let mut checks = 0;
+        let mut failures = 0;
+        for fast in [false, true] {
+            for motion in [None, Some(u64::MAX)] {
+                for rows in [4, 6, 12] {
+                    for height in 1..rows {
+                        let mut e = Engine::new(rows, 10, HostInfo { colors: [[0; 3]; 3], cell_px: (1, 1) });
+                        e.set_fast(fast); e.set_motion(motion);
+                        for _ in 1..rows { e.process(b"x\r\n"); }
+                        e.process(b"z");
+                        assert_eq!(e.scrolled_off_top(), 0);
+                        e.resize(height, 10);
+                        let after_resize = e.scrolled_off_top();
+                        e.process(b"\r\na");
+                        let after_output = e.scrolled_off_top();
+                        let matched = after_resize == rows-height && after_output == rows-height+1;
+                        eprintln!("resize-case rows={rows} height={height} fast={fast} motion={motion:?} expected={},{} actual={after_resize},{after_output} matched={matched}", rows-height, rows-height+1);
+                        if !matched { failures += 1; }
+                        checks += 1;
+                    }
+                }
+            }
+        }
+        eprintln!("scroll resize oracle: {checks} independent cases checked; {failures} mismatches");
+        assert_eq!(failures, 0);
+    }
