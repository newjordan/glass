+/// Experimental role split: the copying-only reader uses the smallest cache
+/// domain; the history-owning parser keeps the largest. Respect the same
+/// opt-out, allowed CPU intersection, and homogeneous-machine no-op policy.
+pub fn place_io_thread() {
+    #[cfg(not(target_os = "linux"))]
+    place_hot_thread();
+    #[cfg(target_os = "linux")]
+    {
+        static CHOSEN: std::sync::OnceLock<Option<Vec<usize>>> = std::sync::OnceLock::new();
+        let cpus = CHOSEN.get_or_init(|| {
+            if !wanted(std::env::var("GLASS_AFFINITY").ok().as_deref()) {
+                return None;
+            }
+            let domains = domains(Path::new("/sys/devices/system/cpu"));
+            let least = domains.iter().map(|d| d.bytes).min()?;
+            if domains.iter().all(|d| d.bytes == least) {
+                return None;
+            }
+            let mut cpus: Vec<_> = domains.iter().filter(|d| d.bytes == least)
+                .flat_map(|d| d.cpus.iter().copied()).collect();
+            cpus.sort_unstable();
+            cpus.dedup();
+            Some(cpus)
+        });
+        if let Some(cpus) = cpus {
+            place_on(cpus);
+        }
+    }
+}
+
+#[cfg(target_os = "linux")]
+fn place_on(cpus: &[usize]) {
+    // SAFETY: both sets are initialized bit arrays, sized for these calls;
+    // every index is checked below MAX_CPUS. Never expand the allowed set.
+    unsafe {
+        let size = std::mem::size_of::<libc::cpu_set_t>();
+        let mut allowed: libc::cpu_set_t = std::mem::zeroed();
+        if libc::sched_getaffinity(0, size, &mut allowed) != 0 {
+            return;
+        }
+        let mut set: libc::cpu_set_t = std::mem::zeroed();
+        let mut any = false;
+        for &cpu in cpus.iter().filter(|&&cpu| cpu < MAX_CPUS) {
+            if libc::CPU_ISSET(cpu, &allowed) {
+                libc::CPU_SET(cpu, &mut set);
+                any = true;
+            }
+        }
+        if any {
+            libc::sched_setaffinity(0, size, &set);
+        }
+    }
+}
