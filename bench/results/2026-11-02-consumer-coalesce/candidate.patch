+    #[test]
+    fn coalescing_takes_at_most_one_extra_queued_handoff() {
+        let (full_tx, full) = mpsc::channel();
+        let (empty, empty_rx) = mpsc::channel();
+        for bytes in [b"abc", b"def", b"ghi"] {
+            full_tx.send((bytes.to_vec(), bytes.len())).unwrap();
+        }
+        let mut ahead = ReadAhead { full, empty, current: Vec::new(), at: 0, end: 0 };
+        let mut out = [0; 64];
+        assert_eq!(ahead.read(&mut out).unwrap(), 6);
+        assert_eq!(&out[..6], b"abcdef");
+        assert_eq!(empty_rx.try_recv().unwrap(), b"abc");
+        assert_eq!(empty_rx.try_recv().unwrap(), b"def");
+        assert!(matches!(empty_rx.try_recv(), Err(TryRecvError::Empty)));
+        drop(full_tx);
+        assert_eq!(ahead.read(&mut out).unwrap(), 3);
+        assert_eq!(&out[..3], b"ghi");
+        assert_eq!(empty_rx.try_recv().unwrap(), b"ghi");
+        assert_eq!(ahead.read(&mut out).unwrap(), 0);
+        assert!(matches!(empty_rx.try_recv(), Err(TryRecvError::Empty)));
+    }
