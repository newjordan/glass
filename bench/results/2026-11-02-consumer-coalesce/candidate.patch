+    #[test]
+    fn coalescing_retains_the_second_handoffs_uncopied_tail() {
+        let (full_tx, full) = mpsc::channel();
+        let (empty, empty_rx) = mpsc::channel();
+        full_tx.send((b"cdEF".to_vec(), 4)).unwrap();
+        let mut ahead = ReadAhead { full, empty, current: b"xab".to_vec(), at: 1, end: 3 };
+        let mut out = [0; 4];
+        assert_eq!(ahead.read(&mut out).unwrap(), 4);
+        assert_eq!(&out, b"abcd");
+        assert_eq!(empty_rx.try_recv().unwrap(), b"xab");
+        assert!(matches!(empty_rx.try_recv(), Err(TryRecvError::Empty)));
+        assert_eq!((ahead.at, ahead.end), (2, 4));
+        assert_eq!(ahead.read(&mut out).unwrap(), 2);
+        assert_eq!(&out[..2], b"EF");
+        assert_eq!(empty_rx.try_recv().unwrap(), b"cdEF");
+        // The sender is still live but no second message exists: the read
+        // above must return its bytes instead of waiting for another message.
+        drop(full_tx);
+        assert_eq!(ahead.read(&mut out).unwrap(), 0);
+        assert!(matches!(empty_rx.try_recv(), Err(TryRecvError::Empty)));
+    }
