@@ -153,6 +153,16 @@ impl Read for ReadAhead {
         if out.is_empty() {
             return Ok(0);
         }
+        let available = self.fill_buf()?;
+        let n = out.len().min(available.len());
+        out[..n].copy_from_slice(&available[..n]);
+        self.consume(n);
+        Ok(n)
+    }
+}
+
+impl BufRead for ReadAhead {
+    fn fill_buf(&mut self) -> io::Result<&[u8]> {
         while self.at >= self.end {
             let spent = std::mem::take(&mut self.current);
             if !spent.is_empty() {
@@ -168,13 +178,14 @@ impl Read for ReadAhead {
                     self.current = buf;
                     self.at = 0;
                 }
-                Err(_) => return Ok(0),
+                Err(_) => return Ok(&[]),
             }
         }
-        let n = out.len().min(self.end - self.at);
-        out[..n].copy_from_slice(&self.current[self.at..self.at + n]);
-        self.at += n;
-        Ok(n)
+        Ok(&self.current[self.at..self.end])
+    }
+
+    fn consume(&mut self, amount: usize) {
+        self.at += amount.min(self.end - self.at);
     }
 }
 
