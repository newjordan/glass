pkgbase = glass-term
	pkgdesc = A GPU terminal that takes in pictures, layers, particles and 3D scenes
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/newjordan/glass
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = python
	depends = fontconfig
	depends = gcc-libs
	depends = glibc
	depends = hicolor-icon-theme
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = vulkan-icd-loader
	depends = wayland
	optdepends = vulkan-driver: Vulkan driver for the GPU
	optdepends = wl-clipboard: clipboard on Wayland
	optdepends = xclip: clipboard on X11
	optdepends = xdg-utils: open links with Ctrl+click
	optdepends = ffmpeg: record the window (GLASS_RECORD)
	optdepends = xdg-terminal-exec: make glass the default terminal
	conflicts = glass-term-bin
	conflicts = glass-git
	source = glass-0.1.0.tar.gz::https://github.com/newjordan/glass/archive/refs/tags/v0.1.0.tar.gz
	sha256sums = SKIP

pkgname = glass-term
